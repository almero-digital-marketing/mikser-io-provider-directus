  "bugs": {
    "url": "https://github.com/almero-digital-marketing/mikser-io-provider-directus/issues"
  },
  "homepage": "https://github.com/almero-digital-marketing/mikser-io-provider-directus#readme",
  "peerDependencies": {
    "mikser-io": "^10.0.0"
  },
  "dependencies": {
    "@directus/sdk": "^20.0.0"
  },
  "devDependencies": {
    "mikser-io": "^10.0.0"
  }
