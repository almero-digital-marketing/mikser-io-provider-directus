{
  "name": "mikser-io-provider-directus",
  "version": "2.0.0",
  "description": "Directus as a content source for mikser-io. Lifecycle plugin syncs configured collections (and the directus_files store) into the catalog; `read(entity)` plugs into the engine's scheme-dispatched readEntityContent. Realtime via outbound WebSocket subscriptions to /websocket \u2014 no public URL required \u2014 with automatic polling fallback.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "node --no-warnings --test --test-reporter=spec 'test/**/*.test.js'",
    "commit": "node ../commit.mjs --only mikser-io-provider-directus",
    "publish:workspace": "node ../publish.mjs --only mikser-io-provider-directus",
    "update": "node ../update.mjs --only mikser-io-provider-directus"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/almero-digital-marketing/mikser-io-provider-directus.git"
  },
  "author": "",
